{
  "name": "imd-doom-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
